# Cross-build environment for the aarch64 DroidVM guest Mesa, driven from an x86_64 host.
#
# Debian 13 (trixie) base intentionally matches the target guest ABI. The previous Ubuntu
# 26.04 build produced libraries that required newer GLIBC / Wayland symbols than Debian 13.
#
# Gaming profile:
#   Xorg/glamor -> Zink -> Turnip -> vDRM -> DRM2KGSL -> Adreno
#
# It is X11-only and does not build llvmpipe, so target Wayland and LLVM are unnecessary.
ARG BASE=debian:13
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture arm64 && apt-get update

RUN apt-get update && apt-get install -y --no-install-recommends \
      crossbuild-essential-arm64 \
      meson ninja-build pkgconf \
      python3 python3-mako python3-yaml python3-packaging \
      bison flex x11proto-dev \
      glslang-tools spirv-tools \
      git ca-certificates xz-utils cmake \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
      libdrm-dev:arm64 \
      libx11-dev:arm64 libx11-xcb-dev:arm64 \
      libxext-dev:arm64 libxfixes-dev:arm64 libxdamage-dev:arm64 \
      libxshmfence-dev:arm64 libxxf86vm-dev:arm64 libxrandr-dev:arm64 \
      libxcb1-dev:arm64 libxcb-dri3-dev:arm64 libxcb-present-dev:arm64 \
      libxcb-sync-dev:arm64 libxcb-randr0-dev:arm64 libxcb-shm0-dev:arm64 \
      libxcb-xfixes0-dev:arm64 libxcb-glx0-dev:arm64 libxcb-dri2-0-dev:arm64 \
      libexpat1-dev:arm64 zlib1g-dev:arm64 libvulkan-dev:arm64 \
      libudev-dev:arm64 libglvnd-dev:arm64 libzstd-dev:arm64 \
      libstdc++6:arm64 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
